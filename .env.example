# Porta COM onde a balanca aparece (cabo serial/USB direto ou Irxon pareado
# via Bluetooth -- os dois criam uma porta COM no Windows). Ex: COM5
# Rode "npm run ports" para listar as portas disponiveis.
# Deixe como "auto" (ou remova a linha) para o servidor descobrir sozinho
# qual porta e a balanca, testando todas as portas disponiveis -- funciona
# tanto por cabo quanto por Bluetooth sem precisar trocar essa config.
SERIAL_PORT=auto

# Velocidade da serial. 9600 e o padrao mais comum em balancas, mas pode variar
# (2400, 4800, 19200...). Ajuste conforme o manual da balanca/irxon.
BAUD_RATE=9600

# Porta HTTP/WebSocket que o site vai consumir
HTTP_PORT=3001

# Nome da impressora instalada no Windows (Configuracoes > Impressoras e
# scanners). Confira com "Get-Printer" no PowerShell.
PRINTER_NAME=LABEL

# Segunda impressora (cupom/recibo), usada pela rota /imprimir/cupom/html.
# Ajuste pro nome real assim que ela for instalada -- mesmo processo de
# descoberta que foi usado pra achar o nome "LABEL" (Get-Printer). Se o nome
# tiver "#" (comum em impressoras duplicadas, ex: "TSC TE200 #2"), PRECISA
# colocar entre aspas -- sem aspas o dotenv corta tudo a partir do "#" por
# achar que e um comentario.
PRINTER_NAME_CUPOM="CUPOM"

# Dominio autorizado a chamar a API pelo navegador (CORS). Em producao,
# troque "*" pelo dominio real do site (ex: https://meusite.com.br).
CORS_ORIGIN=*

# Chave que o site precisa mandar no header "X-API-Key" para poder imprimir.
# Sem isso definido, as rotas /imprimir ficam abertas para qualquer um que
# alcance esse servidor -- so aceitavel em teste local. Gere uma chave forte
# antes de ligar o servidor pra internet/producao.
PRINT_API_KEY=

# Intervalo minimo (ms) entre duas impressoes, pra evitar que um bug/abuso
# no site esgote etiquetas fisicas mandando print em loop.
INTERVALO_MIN_IMPRESSAO_MS=1500

# Tamanho da etiqueta e definido em cada request (larguraMm/alturaMm) --
# nao ha um tamanho fixo travado no servidor, porque a etiqueta fisica pode
# mudar. MAX_MM_TECNICO e so um teto de seguranca (nao de negocio) pra
# recusar um valor absurdo (ex: 999999mm) que travaria o servidor tentando
# renderizar isso. Se o valor mandado for maior que a etiqueta fisica de
# verdade, o resultado e so uma etiqueta cortada, sem erro.
MAX_MM_TECNICO=500

# DPI da impressora -- usado pra converter mm em pixels ao renderizar HTML
# (rota /imprimir/imagem, /imprimir/etiqueta/html e /imprimir/cupom/html). 203dpi e o mais comum nessas
# termicas de etiqueta; se o conteudo sair menor/maior do que deveria na
# etiqueta fisica, o DPI real provavelmente e outro (ex: 300).
PRINTER_DPI=203

# Convencao de bit do comando BITMAP (rotas /imprimir/imagem, /imprimir/etiqueta/html e /imprimir/cupom/html).
# Testado nessa impressora: sem inverter, o fundo saia preto solido e o
# desenho saia branco (o contrario do padrao TSC oficial). Deixe "true"
# nessa impressora; se trocar de modelo e o problema for o oposto (fundo
# branco normal mas o desenho sai invertido), mude pra "false".
INVERTER_BITMAP=true
